# El DNS de este dominio debe apuntar al VPS antes de levantar el contenedor,
# para que Caddy pueda emitir el certificado HTTPS (Let's Encrypt) automáticamente.
{$DOMAIN:gabinetesocial.riocuarto.gob.ar} {
	root * /srv
	file_server
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
