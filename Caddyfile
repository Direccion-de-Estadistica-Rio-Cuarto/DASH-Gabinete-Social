# Coolify/Cloudflare terminan el HTTPS por delante; Caddy sirve en HTTP plano
# por los puertos 80 y 3000.
:80, :3000 {
	root * /srv
	file_server
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Permite embeber el tablero solo en los sitios listados (reemplaza a
		# X-Frame-Options, que no admite más de un origen autorizado).
		Content-Security-Policy "frame-ancestors 'self' https://observatorio.datosriocuarto.gob.ar"
	}
}
